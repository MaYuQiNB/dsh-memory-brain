{
  "name": "dsh-memory-brain",
  "version": "0.5.5",
  "description": "A human-brain-inspired memory system for DSH: tags every conversation turn, forgets by the Ebbinghaus curve over time, and renders the whole memory network as a full-page 3D force-directed graph.",
  "type": "module",
  "main": "index.js",
  "license": "MIT",
  "author": "MaYuQiNB",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaYuQiNB/dsh-memory-brain.git"
  },
  "homepage": "https://github.com/MaYuQiNB/dsh-memory-brain#readme",
  "bugs": {
    "url": "https://github.com/MaYuQiNB/dsh-memory-brain/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "memory",
    "ebbinghaus",
    "forgetting-curve",
    "3d",
    "graph",
    "qq"
  ],
  "scripts": {
    "test": "node --test --test-isolation=none test/engine.test.mjs test/store.test.mjs test/host.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
